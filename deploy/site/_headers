# Static HTTP cache rules for the public site (`deploy/site/`).
# Copied into `tmp/site/dist/_headers` by `scripts/build-site.mjs` for hosts
# that read `_headers` (Cloudflare Workers Assets, Cloudflare Pages, Netlify).

# HTML documents, favicons, search indexes, and the OpenAPI spec always revalidate on
# visit so docs, spec, and console updates after merges take effect immediately.
/*
  Cache-Control: public, max-age=0, must-revalidate

# Content-hashed bundles change filenames when rebuilt and can be cached immutably.
# Detach the inherited Cache-Control header from /* first so Cloudflare does not join both.
/docs/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/api-reference/scalar.*.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/demo/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
