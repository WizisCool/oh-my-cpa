{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "oh-my-cpa-site",
  "main": "worker.mjs",
  // Public site for `omc.junze.dev` serving `/` (landing), `/api-docs/` (Scalar),
  // and `/demo/` (interactive console demo mounted under `/demo`).
  // Keep `workers_dev` off so account-derived hostnames do not publish operator identity.
  "workers_dev": false,
  "routes": [{ "pattern": "omc.junze.dev", "custom_domain": true }],
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../../tmp/site/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/demo", "/demo/*"]
  },
  "observability": {
    "enabled": true
  }
}
