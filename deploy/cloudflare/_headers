# Response headers for the demonstration's static assets.
#
# The file is copied into the staged asset directory by `scripts/build-demo.mjs`, and
# Cloudflare applies these rules to static asset responses instead of serving the file.

# Everything outside hashed bundles - the documents, the icons and the SPA's fallback -
# must not pin an old index.html across deployments.
/*
  Cache-Control: no-store

# Hashed build output: the name changes when the content does, so it can be cached
# indefinitely. Detach the inherited Cache-Control header from /* first so Cloudflare
# does not join both.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable