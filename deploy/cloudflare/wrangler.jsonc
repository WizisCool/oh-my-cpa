{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "oh-my-cpa-demo",
  "main": "worker.mjs",
  // The demonstration answers on its own domain only. The `workers.dev` route is off
  // because that subdomain is account-level and is derived from the operator's account
  // identity, so leaving it on would publish the demonstration at an address carrying
  // personal information. Stating both here rather than configuring them once in the
  // console is what makes a deploy from a fresh clone reproduce the deployed state
  // instead of quietly re-enabling the address that was turned off on purpose.
  "workers_dev": false,
  "routes": [{ "pattern": "omc-demo.junze.dev", "custom_domain": true }],
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../../tmp/cloudflare-demo/assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
