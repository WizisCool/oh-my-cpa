{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oh-my-cpa-demo",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../../tmp/cloudflare-demo/assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
