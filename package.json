{
  "name": "oh-my-cpa",
  "description": "Self-hosted control plane & usage observability console for CLIProxyAPI (CPA).",
  "private": true,
  "version": "0.3.8",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm --dir web build && node scripts/sync-web-dist.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "check-brand": "node scripts/sync-brand.mjs --check",
    "check-css-modules": "node scripts/check-css-modules.mjs",
    "check-docs": "node scripts/check-docs.mjs",
    "check-i18n": "node scripts/check-missing-i18n.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:demo": "node --import tsx scripts/check-demo.ts",
    "check:motion": "node scripts/check-motion.mjs",
    "check:feedback": "node scripts/check-feedback.mjs",
    "check:style-tokens": "node scripts/check-style-tokens.mjs",
    "check:ui": "node --import tsx scripts/check-ui.ts",
    "cpa:start": "node scripts/cpa-start.mjs",
    "demo:generate": "node scripts/generate-demo-data.mjs",
    "icons:generate": "node scripts/generate-lucide-icons.mjs",
    "icons:lobe": "node scripts/sync-lobe-icon-catalog.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev.mjs --api-only",
    "dev:demo": "wrangler dev --config deploy/cloudflare/wrangler.jsonc",
    "dev:web": "pnpm --dir web dev",
    "lint:antd": "node scripts/lint-antd.mjs",
    "readme:screenshots": "node scripts/readme-screenshots.mjs",
    "subset-font": "node scripts/subset-font.mjs",
    "sync-brand": "node scripts/sync-brand.mjs",
    "sync-web-dist": "node scripts/sync-web-dist.mjs",
    "test:affected-checks": "node --import tsx --test scripts/affected-checks.test.mjs",
    "test:brand": "node --import tsx --test scripts/sync-brand.test.mjs",
    "test:build-demo": "node --import tsx --test scripts/build-demo.test.mjs",
    "test:chart-marks": "node --import tsx scripts/test-chart-marks.ts",
    "test:check-demo": "node --import tsx --test scripts/check-demo.test.ts",
    "test:check-ui-plan": "node --import tsx --test scripts/check-ui-plan.test.mjs",
    "test:config-states": "node --import tsx scripts/test-config-states.ts",
    "test:css-modules": "node --import tsx --test scripts/check-css-modules.test.mjs",
    "test:demo": "node --import tsx --test deploy/cloudflare/*.test.mjs",
    "test:dev-target": "node --import tsx --test scripts/api-target.test.mjs",
    "test:docs": "node --import tsx --test scripts/check-docs.test.mjs",
    "test:fast": "node scripts/verify-fast.mjs",
    "test:i18n": "node --import tsx --test scripts/check-missing-i18n.test.mjs",
    "test:feedback": "node --import tsx --test scripts/check-feedback.test.mjs",
    "test:install-chromium": "node --import tsx --test scripts/install-chromium.test.mjs",
    "test:logic": "node --import tsx scripts/testing/logic.ts",
    "test:mask-key": "node --import tsx scripts/test-mask-key.ts",
    "test:motion": "node --import tsx --test scripts/check-motion.test.mjs",
    "test:payload": "node --import tsx scripts/test-payload-rules.ts",
    "test:provider-console": "node --import tsx scripts/test-provider-console.ts",
    "test:provider-toggle": "node --import tsx scripts/test-provider-toggle-queue.ts",
    "test:scroll-intent": "node --import tsx scripts/test-scroll-intent.ts",
    "test:self": "node --import tsx scripts/testing/repository.ts",
    "test:sync-web-dist": "node --import tsx --test scripts/sync-web-dist.test.mjs",
    "test:usage-events": "node --import tsx scripts/test-usage-event-view.ts",
    "test:view-policy": "node --import tsx scripts/test-usage-events-view-policy.ts",
    "test:visible-clock": "node --import tsx scripts/test-visible-clock.ts",
    "type-check": "pnpm --dir web type-check && pnpm type-check:tooling",
    "type-check:incremental": "pnpm --dir web exec tsc --noEmit --incremental --tsBuildInfoFile ../tmp/tsc/web.tsbuildinfo && pnpm type-check:tooling",
    "verify": "pnpm verify:toolchain && pnpm verify:static && pnpm verify:secrets:worktree",
    "verify:browser": "node --import tsx scripts/browser-acceptance.mjs",
    "verify:browser:p0": "node --import tsx scripts/browser-acceptance.mjs --p0",
    "verify:browser:smoke": "node --import tsx scripts/browser-acceptance.mjs --smoke",
    "verify:build": "pnpm type-check && pnpm build && pnpm check:bundle",
    "verify:demo": "node scripts/verify-demo.mjs",
    "verify:demo:go": "node scripts/demo-smoke.mjs",
    "verify:e2e": "pnpm build && pnpm check:bundle && pnpm verify:browser && pnpm verify:probes",
    "verify:full": "node --import tsx scripts/verify-full.ts",
    "verify:full:serial": "node --import tsx scripts/verify-full.ts --serial",
    "verify:live": "node scripts/browser-live-smoke.mjs",
    "verify:probes": "node --import tsx scripts/testing/probes.ts",
    "verify:secrets": "pnpm verify:secrets:worktree",
    "verify:secrets:history": "node scripts/secret-scan.mjs --history",
    "verify:secrets:staged": "node scripts/secret-scan.mjs --staged",
    "verify:secrets:worktree": "node scripts/secret-scan.mjs --worktree",
    "verify:static": "node --import tsx scripts/verify-static.ts",
    "verify:static:frontend": "pnpm type-check && pnpm test:logic && pnpm test:components && pnpm lint:antd",
    "verify:static:go": "go test ./... && go vet ./...",
    "verify:static:repository": "pnpm verify:workflow && pnpm check-i18n && pnpm check-docs && pnpm check-brand && pnpm check-css-modules && pnpm check:motion && pnpm check:style-tokens && pnpm check:feedback && pnpm test:self",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "verify:toolchain:strict": "node scripts/verify-toolchain.mjs --strict",
    "verify:workflow": "node scripts/validate-workflow.mjs",
    "models:sync": "node scripts/sync-model-metadata.mjs",
    "verify:race": "node scripts/maintenance-checks.mjs race",
    "verify:fuzz": "node scripts/maintenance-checks.mjs fuzz",
    "verify:advisories": "node scripts/maintenance-checks.mjs advisories",
    "report:probe-timings": "node scripts/probe-timing-report.mjs",
    "verify:workflow:lint": "node scripts/lint-workflows.mjs",
    "verify:browser:harness": "node --import tsx scripts/testing/harness.ts",
    "benchmark:native": "node scripts/benchmark-native-builds.mjs",
    "test:components": "node scripts/test-components.mjs",
    "type-check:tooling": "tsc --project tsconfig.tooling.json"
  },
  "devDependencies": {
    "@ant-design/cli": "6.6.2",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "playwright-core": "1.62.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wrangler": "4.144.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": "22.23.4",
    "pnpm": "11.19.0"
  }
}
