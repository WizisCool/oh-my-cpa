{
  "name": "oh-my-cpa",
  "description": "Self-hosted control plane & usage observability console for CLIProxyAPI (CPA).",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm --dir web build && node scripts/sync-web-dist.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "check-brand": "node scripts/sync-brand.mjs --check",
    "check-css-modules": "node scripts/check-css-modules.mjs",
    "check-docs": "node scripts/check-docs.mjs",
    "check-i18n": "node scripts/check-missing-i18n.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "cpa:start": "node scripts/cpa-start.mjs",
    "demo:generate": "node scripts/generate-demo-data.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev.mjs --api-only",
    "dev:demo": "wrangler dev --config deploy/cloudflare/wrangler.jsonc",
    "dev:web": "pnpm --dir web dev",
    "lint:antd": "node scripts/lint-antd.mjs",
    "prune:vcr-images": "node scripts/prune-vcr-images.mjs",
    "subset-font": "node scripts/subset-font.mjs",
    "sync-brand": "node scripts/sync-brand.mjs",
    "sync-web-dist": "node scripts/sync-web-dist.mjs",
    "test:affected-checks": "node --test scripts/affected-checks.test.mjs",
    "test:brand": "node --test scripts/sync-brand.test.mjs",
    "test:chart-marks": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-chart-marks.ts",
    "test:check-ui-plan": "node --test scripts/check-ui-plan.test.mjs",
    "test:config-states": "node --experimental-strip-types scripts/test-config-states.ts",
    "test:css-modules": "node --test scripts/check-css-modules.test.mjs",
    "test:demo": "node --test deploy/cloudflare/worker.test.mjs",
    "test:dev-target": "node --test scripts/api-target.test.mjs",
    "test:docs": "node --test scripts/check-docs.test.mjs",
    "test:fast": "node scripts/verify-fast.mjs",
    "test:i18n": "node --test scripts/check-missing-i18n.test.mjs",
    "test:install-chromium": "node --test scripts/install-chromium.test.mjs",
    "test:logic": "node scripts/test-logic.mjs",
    "test:mask-key": "node --experimental-strip-types scripts/test-mask-key.ts",
    "test:motion": "node --test scripts/check-motion.test.mjs",
    "test:payload": "node --experimental-strip-types scripts/test-payload-rules.ts",
    "test:provider-console": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-provider-console.ts",
    "test:provider-toggle": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-provider-toggle-queue.ts",
    "test:scroll-intent": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-scroll-intent.ts",
    "test:self": "pnpm test:i18n && pnpm test:docs && pnpm test:css-modules && pnpm test:motion && pnpm test:dev-target && pnpm test:affected-checks && pnpm test:sync-web-dist && pnpm test:install-chromium && pnpm test:check-ui-plan && pnpm test:brand && pnpm test:demo",
    "test:sync-web-dist": "node --test scripts/sync-web-dist.test.mjs",
    "test:usage-events": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-usage-event-view.ts",
    "test:view-policy": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-usage-events-view-policy.ts",
    "test:visible-clock": "node --experimental-strip-types scripts/test-visible-clock.ts",
    "type-check": "pnpm --dir web type-check",
    "verify": "pnpm verify:toolchain && pnpm verify:static && pnpm verify:secrets:worktree",
    "verify:browser": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/browser-acceptance.mjs",
    "verify:browser:p0": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/browser-acceptance.mjs --p0",
    "verify:browser:release": "node scripts/run-browser-release.mjs",
    "verify:browser:smoke": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/browser-acceptance.mjs --smoke",
    "verify:build": "pnpm type-check && pnpm build && node scripts/check-bundle-budget.mjs",
    "verify:demo": "node scripts/demo-smoke.mjs",
    "verify:e2e": "pnpm build && pnpm verify:browser && pnpm verify:probes",
    "verify:full": "node scripts/verify-full.mjs",
    "verify:full:serial": "pnpm verify:toolchain:strict && pnpm verify:static:go && pnpm verify:static:frontend && pnpm verify:static:repository && pnpm verify:secrets:worktree && pnpm verify:secrets:history && pnpm build && node scripts/check-bundle-budget.mjs && pnpm verify:browser && pnpm verify:probes && pnpm verify:demo",
    "verify:live": "node scripts/browser-live-smoke.mjs",
    "verify:probes": "node scripts/browser-probes.mjs",
    "verify:secrets": "pnpm verify:secrets:worktree",
    "verify:secrets:history": "node scripts/secret-scan.mjs --history",
    "verify:secrets:staged": "node scripts/secret-scan.mjs --staged",
    "verify:secrets:worktree": "node scripts/secret-scan.mjs --worktree",
    "verify:static": "node scripts/verify-static.mjs",
    "verify:static:frontend": "pnpm type-check && pnpm test:logic && pnpm lint:antd",
    "verify:static:go": "go test ./... && go vet ./...",
    "verify:static:repository": "pnpm verify:workflow && pnpm check-i18n && pnpm check-docs && pnpm check-brand && pnpm check-css-modules && pnpm check:motion && pnpm test:self",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "verify:toolchain:strict": "node scripts/verify-toolchain.mjs --strict",
    "verify:workflow": "node scripts/validate-workflow.mjs"
  },
  "devDependencies": {
    "@ant-design/cli": "6.6.2",
    "playwright-core": "1.62.1",
    "wrangler": "4.135.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": "22.23.2",
    "pnpm": "11.19.0"
  }
}
