# Vercel container build for the public demonstration.
#
# Vercel detects this file at the project root, builds the image, and routes every
# request to it; see https://vercel.com/docs/functions/container-images. It is
# deliberately separate from `Dockerfile`, which stays the self-hosted image: this
# one runs the same binary in demo mode, serves the console at the site root, keeps
# its data in the platform's temporary directory, and listens where the platform
# routes traffic.
#
# Everything it needs to run is embedded in the binary, so the runtime stage carries
# no Node.js, no package manager and no source tree.

FROM node:22.23.2-alpine AS web
WORKDIR /src
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY web/package.json ./web/package.json
RUN corepack enable && pnpm install --frozen-lockfile
COPY web/ ./web/
# The whole directory rather than the two helpers the build imports today: vite.config
# resolves them by relative path, and a build stage that lists its own inputs fails the
# day one of them gains a sibling.
COPY scripts/ ./scripts/
RUN pnpm --dir web run build

FROM golang:1.24.13-alpine AS server
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# The embedded bundle is the image's own frontend, never whatever a developer
# happened to have synced into the worktree: the previous stage just built it.
RUN rm -rf internal/web/dist && mkdir -p internal/web/dist
COPY --from=web /src/web/dist/ ./internal/web/dist/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/oh-my-cpa ./cmd/oh-my-cpa

FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata
COPY --from=server /out/oh-my-cpa /usr/local/bin/oh-my-cpa
COPY deploy/vercel/entrypoint.sh /usr/local/bin/omc-demo-entrypoint
RUN chmod +x /usr/local/bin/omc-demo-entrypoint

# The platform routes to port 80 unless the project sets PORT, and a container runs
# as root unless the image says otherwise, so 80 is the port that needs no project
# configuration at all. The entry point honours PORT when a project does set it.
ENV OMCPA_DEMO_MODE=true \
    OMCPA_BASE_PATH=/ \
    OMCPA_DATA_DIR=/tmp/oh-my-cpa-demo \
    OMCPA_LISTEN_ADDR=:80 \
    OMCPA_USAGE_INGEST_ENABLED=false \
    OMCPA_VERSION=v0.1.0-demo
EXPOSE 80

ENTRYPOINT ["/usr/local/bin/omc-demo-entrypoint"]
