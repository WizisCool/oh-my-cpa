   {
    "id": "call_122a49ef22bc7626687476829ba37d32",
    "name": "database_query",
    "arguments": {
     "sql": "SELECT date(timestamp_ms / 1000, 'unixepoch') AS day, COUNT(*) AS requests, SUM(CASE WHEN failed = 1 THEN 1 ELSE 0 END) AS failures, ROUND(1.0 * SUM(CASE WHEN failed = 1 THEN 1 ELSE 0 END) / COUNT(*), 4) AS failure_rate FROM usage_events WHERE timestamp_ms >= {{ms:-168}} AND timestamp_ms < {{ms:0}} GROUP BY day ORDER BY day",
     "max_rows": 20
    },
    "result": {
     "status": "success",
     "operation_id": "ee2f86969aad000efb744b5b1022d6e8532166744822fc4f"
    },
    "duration_ms": 186
   },
   {
