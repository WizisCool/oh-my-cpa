      "zh": "<div class=\"omc-stack\"><div class=\"omc-grid\" id=\"stats\"></div><div class=\"omc-row\"><label>查看指标 <select id=\"metric\"><option value=\"requests\">请求数</option><option value=\"failure_rate\">失败率</option></select></label></div><div id=\"chart\"></div><div style=\"overflow-x:auto\" id=\"table\"></div><div class=\"omc-callout\">窗口：{{ymd:-7}} {{hm}}–{{md:0}} {{hm}}（UTC）。{{md:-7}}与{{md:0}}仅包含窗口内的部分时段；统计仅覆盖保留的请求记录。</div></div><script>const rows=OMC.rows;const n=rows.reduce((s,r)=>s+r.requests,0),f=rows.reduce((s,r)=>s+r.failures,0);document.getElementById('stats').innerHTML='<div class=\"omc-stat\"><small>窗口请求总数</small><b>'+n.toLocaleString('zh-CN')+'</b></div><div class=\"omc-stat\"><small>窗口失败请求数</small><b>'+f.toLocaleString('zh-CN')+'</b></div><div class=\"omc-stat\"><small>窗口失败率</small><b>'+(100*f/n).toFixed(1)+'%</b><span>按请求数加权</span></div>';function draw(){const k=document.getElementById('metric').value;OMC.chart('#chart',{type:k==='requests'?'column':'line',x:'day',y:[k],unit:k==='requests'?'number':'percent',rows});}document.getElementById('metric').addEventListener('change',draw);draw();OMC.table('#table',{columns:[{field:'day',label:'日期'},{field:'requests',label:'请求数',unit:'number'},{field:'failures',label:'失败请求数',unit:'number'},{field:'failure_rate',label:'失败率',unit:'percent'}],rows});</script>",
      "en": "<div class=\"omc-stack\"><div class=\"omc-grid\" id=\"stats\"></div><div class=\"omc-row\"><label>Metric <select id=\"metric\"><option value=\"requests\">Requests</option><option value=\"failure_rate\">Failure rate</option></select></label></div><div id=\"chart\"></div><div style=\"overflow-x:auto\" id=\"table\"></div><div class=\"omc-callout\">Window: {{ymd:-7}} {{hm}} – {{md:0}} {{hm}} (UTC). {{md:-7}} and {{md:0}} hold only the part of the day inside the window; the counts cover retained request records only.</div></div><script>const rows=OMC.rows;const n=rows.reduce((s,r)=>s+r.requests,0),f=rows.reduce((s,r)=>s+r.failures,0);document.getElementById('stats').innerHTML='<div class=\"omc-stat\"><small>Requests in window</small><b>'+n.toLocaleString('en-US')+'</b></div><div class=\"omc-stat\"><small>Failed requests</small><b>'+f.toLocaleString('en-US')+'</b></div><div class=\"omc-stat\"><small>Failure rate</small><b>'+(100*f/n).toFixed(1)+'%</b><span>Weighted by requests</span></div>';function draw(){const k=document.getElementById('metric').value;OMC.chart('#chart',{type:k==='requests'?'column':'line',x:'day',y:[k],unit:k==='requests'?'number':'percent',rows});}document.getElementById('metric').addEventListener('change',draw);draw();OMC.table('#table',{columns:[{field:'day',label:'Day'},{field:'requests',label:'Requests',unit:'number'},{field:'failures',label:'Failed requests',unit:'number'},{field:'failure_rate',label:'Failure rate',unit:'percent'}],rows});</script>"
     }
