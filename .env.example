# Oh My CPA 本地调试环境变量（勿提交：已在 .gitignore 中忽略）
# 由 cmd/oh-my-cpa 在 config.Load() 之前读取；真实环境变量优先级更高。
# 配套 CLIProxyAPI 位于 ./cpa（同样不提交），启动命令见 README「本地联调」。

# --- Oh My CPA 服务 ---
OMCPA_LISTEN_ADDR=127.0.0.1:8080
OMCPA_BASE_PATH=/omc
OMCPA_DATA_DIR=tmp/oh-my-cpa-data
OMCPA_VERSION=v0.1.0-dev

# 登录密码 = 下面的 CPA Management Key（与 CPA 自带面板同一凭证）
OMCPA_MASTER_KEY=${{64位十六进制主密钥（ openssl rand -hex 32 生成）}}

# --- 本地 CLIProxyAPI (./cpa/config.yaml) ---
# host: 127.0.0.1, port: 8317, remote-management.secret-key 对应的明文
OMCPA_CPA_BASE_URL=http://127.0.0.1:8317
OMCPA_CPA_MANAGEMENT_KEY=your-cpa-management-key
OMCPA_CPA_USAGE_ADDR=127.0.0.1:8317
OMCPA_REQUEST_TIMEOUT=15s
OMCPA_CPA_TLS_SKIP_VERIFY=false
